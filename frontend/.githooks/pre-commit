#!/bin/sh
pattern='sk-or-v1-[0-9a-fA-F]{20,}|sk-ant-[A-Za-z0-9_-]{20,}|sk-proj-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|aws_secret_access_key[[:space:]]*=[[:space:]]*[A-Za-z0-9/+]{30,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|xox[baprs]-[A-Za-z0-9-]{10,}|ghp_[A-Za-z0-9]{30,}'
blocked=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$')
if [ -n "$blocked" ]; then
  echo "pre-commit: refusing to commit env files:"; echo "$blocked"; exit 1
fi
hits=$(git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+' | grep -nE "$pattern")
if [ -n "$hits" ]; then
  echo "pre-commit: possible secret in staged changes:"; echo "$hits" | sed -E 's/(sk-or-v1-|sk-ant-|sk-proj-|AKIA|ASIA|ghp_)[A-Za-z0-9_-]+/\1<redacted>/g'; exit 1
fi
exit 0
